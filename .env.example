# Variables de entorno del proyecto (valores de EJEMPLO, sin secretos reales).
# Este archivo es una referencia: el proyecto lee las variables del sistema.
# En Windows (Símbolo del sistema), definir antes de ejecutar, por ejemplo:
#   set "DB_PASSWORD=tu_clave"
# Solo DB_PASSWORD es obligatoria; las demás tienen valores por defecto.
DB_NAME=festival_votaciones
DB_USER=festival
DB_PASSWORD=cambia_esta_clave
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=1